object server extends ScalaModule with ScalafixModule {
  def moduleDeps = Seq(shared, measures)
  def scalaVersion = "3.8.3"
  def mvnDeps = Seq(
    mvn"org.scalacheck::scalacheck::1.19.0",
    mvn"org.scalactic::scalactic::3.2.20",
    mvn"org.scalatest::scalatest::3.2.20",
    mvn"io.suzaku::boopickle::1.5.0",
    mvn"org.typelevel::squants::1.8.3",
    mvn"com.typesafe.akka::akka-http::10.5.3",
    mvn"org.typelevel::cats-core::2.13.0",
    mvn"com.github.scopt::scopt::4.1.0",
    mvn"com.outr::scribe::3.19.0",
    mvn"com.typesafe.akka::akka-actor::2.8.8",
    mvn"com.typesafe.akka::akka-stream::2.8.8"
  )
  def resources = Task {
    os.makeDir(Task.dest / "web")

    val jsPath = client.fastLinkJS().dest.path

    os.copy(jsPath / "main.js", Task.dest / "web" / "main.js")
    os.copy(jsPath / "main.js.map", Task.dest / "web" / "main.js.map")

    super.resources() ++ Seq(PathRef(Task.dest))
  }
  def scalacOptions = Seq("-feature", "-deprecation")

  object test extends ScalaTests with TestModule.ScalaTest {
    def sources = Task.Sources("scala")
    def mvnDeps = Seq(
      mvn"org.scalatest::scalatest::3.2.20",
      mvn"org.scalatestplus::scalacheck-1-18::3.2.19.0",
      mvn"org.scalacheck::scalacheck::1.19.0"
    )
  }
}

