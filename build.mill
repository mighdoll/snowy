object client extends ScalaJSModule with ScalafixModule {
  def scalaVersion = "3.7.3"
  def scalaJSVersion = "1.20.1"
  def moduleDeps = Seq(shared)
  def mvnDeps = Seq(
    mvn"org.scalacheck::scalacheck::1.17.0",
    mvn"org.scalactic::scalactic::3.2.16",
    mvn"org.scalatest::scalatest::3.2.16",
    mvn"org.scala-js::scalajs-dom::2.6.0",
  )
  def moduleKind = ModuleKind.ESModule

  def scalacOptions = Seq("-feature", "-deprecation")
}

object shared extends ScalaModule with ScalaJSModule with ScalafixModule {
  def scalaVersion = "3.7.3"
  def scalaJSVersion = "1.20.1"
  def mvnDeps = Seq(
    mvn"org.scalacheck::scalacheck::1.17.0",
    mvn"org.scalactic::scalactic::3.2.16",
    mvn"org.scalatest::scalatest::3.2.16",
